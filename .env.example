# Gemini API Key (Required for Gemini model execution)
GEMINI_API_KEY=your_gemini_api_key_here

# Parallel API Key (Required for live Parallel Search API calls)
# Get your key at https://parallel.ai
PARALLEL_API_KEY=your_parallel_api_key_here

# Optional: Default Gemini model (e.g., gemini-2.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Parallel API endpoint override
PARALLEL_API_URL=https://api.parallel.ai/v1/search
